{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boardofprojectstewardship.com/intake/schema/manifest.schema.json",
  "title": "Board agent intake manifest",
  "description": "Controlled intake packet. Steward is the only publisher. This schema is the contract; tools/board_intake.py enforces it without a network call and without secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "submission_id", "kind", "producer", "created_at", "target", "artifacts"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$",
      "description": "Stable id. Reuse it for idempotent replay. A different artifact hash with the same id is a conflict after publish."
    },
    "kind": {
      "type": "string",
      "enum": ["post-bundle", "draft", "sources", "seo-brief", "media", "coordination"]
    },
    "producer": {
      "type": "string",
      "enum": ["chief-of-staff", "ollama", "hermes", "openclaw", "grok-build"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "example": {
      "type": "boolean",
      "description": "Example packets validate and dry-run, and are refused by publish --apply."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Optional sha256:<64 hex>. If present it must match the tool's canonical hash of the manifest (without this field) plus artifact bytes."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "content_type"],
      "properties": {
        "site": {
          "type": "string",
          "description": "Must be https://boardofprojectstewardship.com/ . pacificprogroup.com is rejected."
        },
        "content_type": {"type": "string", "enum": ["blog-post", "note"]}
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "description": "Required on post-bundle. Each value is fixed to that specialty.",
      "required": ["assembler", "draft", "sources", "seo", "media"],
      "properties": {
        "assembler": {"type": "string", "const": "chief-of-staff"},
        "draft": {"type": "string", "const": "ollama"},
        "sources": {"type": "string", "const": "hermes"},
        "seo": {"type": "string", "const": "openclaw"},
        "media": {"type": "string", "const": "grok-build"}
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "date", "slug", "description", "category"],
      "properties": {
        "title": {"type": "string", "minLength": 8, "maxLength": 140},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
        "description": {"type": "string", "minLength": 20, "maxLength": 300},
        "category": {
          "type": "string",
          "enum": ["Guides", "Additions", "Kitchen", "Bathrooms", "Hiring Guides", "Permits"]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draft": {"type": "string"},
        "sources": {"type": "string"},
        "seo": {"type": "string"},
        "media": {"type": "string"},
        "coordination": {"type": "string"}
      }
    },
    "relates_to": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Other submission_id values. Coordination packets use this; it is not published."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "post-bundle"}}, "required": ["kind"]},
      "then": {
        "required": ["roles", "post"],
        "properties": {
          "producer": {"const": "chief-of-staff"},
          "artifacts": {"required": ["draft", "sources", "seo", "media"]}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "draft"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "producer": {"const": "ollama"},
          "artifacts": {"required": ["draft"]}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "sources"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "producer": {"const": "hermes"},
          "artifacts": {"required": ["sources"]}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "seo-brief"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "producer": {"const": "openclaw"},
          "artifacts": {"required": ["seo"]}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "media"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "producer": {"const": "grok-build"},
          "artifacts": {"required": ["media"]}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "coordination"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "producer": {"const": "chief-of-staff"},
          "artifacts": {"required": ["coordination"]}
        }
      }
    }
  ]
}
